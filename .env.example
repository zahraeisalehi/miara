# Copy to .env.local and fill in (the spikes and apps read .env.local). Never commit real values.

# Liara API token (JWT from console.liara.ir → API). Full-access; Miara's policy gate is the only guardrail.
LIARA_API_TOKEN=

# Optional: Liara team ID (team mode). Empty = personal account. Find it with `liara team:list -x`.
# Sent as the `teamID` query parameter on every Liara request, like the CLI (base.ts:285-293).
LIARA_TEAM_ID=

# LLM provider: boxapi | liara (both OpenAI-compatible; see docs/boxapi/README.md)
LLM_PROVIDER=boxapi
BOXAPI_API_KEY=
BOXAPI_MODEL=

# Local Postgres from docker-compose.yml (host port 5433)
DATABASE_URL=postgres://miara:miara@localhost:5433/miara

# apps/web dev port (3000 is reserved for another local project)
WEB_PORT=3100
